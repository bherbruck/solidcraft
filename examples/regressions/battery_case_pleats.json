{
 "description": "A battery case shelled outward 3.5 mm, rounded R5 along its long edges and R1 round both ends (#1669). A window is cut through its front wall and a pleat lofted between an 18-point zig-zag and a flat band is joined into it; the window and the pleat are mirrored to the far end about a plane at half the length. The pleat's twisted ruled faces were meshed off their surfaces along their straight sides, so the meshes the joins are checked on misjudged them: the mirror failed with 'boolean Union: no result', and so did the same window and pleat built directly at the far end of the finished case at 3 mm.",
 "commands": [
  {"command": "parameters.add", "params": {"comment": "Battery flat top/bottom width", "expression": "290 mm", "name": "batt_w", "unit": "mm"}},
  {"command": "parameters.add", "params": {"comment": "Side bulge past the top/bottom corners", "expression": "10 mm", "name": "batt_bulge", "unit": "mm"}},
  {"command": "parameters.add", "params": {"comment": "Battery height", "expression": "92 mm", "name": "batt_h", "unit": "mm"}},
  {"command": "parameters.add", "params": {"comment": "Height of the left side's widest point", "expression": "27 mm", "name": "peak_left", "unit": "mm"}},
  {"command": "parameters.add", "params": {"comment": "Height of the right side's widest point", "expression": "batt_h - peak_left", "name": "peak_right", "unit": "mm"}},
  {"command": "parameters.add", "params": {"comment": "Battery length", "expression": "198 mm", "name": "batt_len", "unit": "mm"}},
  {"command": "parameters.add", "params": {"comment": "Connector tab width", "expression": "15 mm", "name": "tab_w", "unit": "mm"}},
  {"command": "parameters.add", "params": {"comment": "Connector tab protrusion", "expression": "5.5 mm", "name": "tab_depth", "unit": "mm"}},
  {"command": "parameters.add", "params": {"comment": "Ramp from tab back to the wall", "expression": "35 mm", "name": "ramp_len", "unit": "mm"}},
  {"command": "parameters.add", "params": {"comment": "Blend radius ramp to wall", "expression": "80 mm", "name": "ramp_blend_wall", "unit": "mm"}},
  {"command": "parameters.add", "params": {"comment": "Blend radius tab to ramp", "expression": "40 mm", "name": "ramp_blend_tab", "unit": "mm"}},
